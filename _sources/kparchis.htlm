<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ParGEnius - Parchís Generativo</title>
    <!-- Carga de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Tipografía Inter y estilos base */
        :root {
            --bg-color: #1a1a2e; /* Fondo oscuro inicial */
            --accent-color: #e94560; /* Color de acento */
            --board-color-light: #2c2e43;
            --board-color-dark: #16213e;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            transition: background-color 0.5s ease;
            color: #e4e4e7; /* Gris claro para texto */
        }

        .board-container {
            width: 95vw;
            max-width: 600px;
            aspect-ratio: 1 / 1;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            background: linear-gradient(145deg, var(--board-color-dark), var(--board-color-light));
            border-radius: 20px;
            padding: 1rem;
        }

        .piece {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.3);
            transition: transform 0.15s ease, opacity 0.15s ease, box-shadow 0.15s ease;
        }

        .piece:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.7);
        }

        .highlight-movable {
            animation: pulse-border 1s infinite alternate;
        }

        @keyframes pulse-border {
            from { border-color: white; box-shadow: 0 0 10px white; }
            to { border-color: var(--accent-color); box-shadow: 0 0 15px var(--accent-color); }
        }

        /* Estilos para las casillas */
        .path-square {
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .path-square.safe {
            background-color: rgba(255, 255, 255, 0.3);
        }

        /* Colores de las casas y metas */
        .house-yellow, .start-yellow, .goal-yellow { background-color: #fcd34d; }
        .house-blue, .start-blue, .goal-blue { background-color: #3b82f6; }
        .house-red, .start-red, .goal-red { background-color: #ef4444; }
        .house-green, .start-green, .goal-green { background-color: #10b981; }

        .dice-button {
            background-color: var(--accent-color);
            transition: all 0.3s ease;
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.4);
        }
        .dice-button:hover {
            background-color: #fb7185;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.6);
        }

        /* Estilo para el dado */
        .dice-display {
            font-size: 2rem;
            width: 70px;
            height: 70px;
            background-color: #1f2937;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
            transform: rotateY(0deg) rotateX(0deg);
            transition: transform 0.5s ease-out;
        }

        /* Overlay de notificación Generativa */
        #notification-overlay {
            z-index: 50;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
        }
        .notification-box {
            animation: fadeInScale 0.4s ease-out;
        }
        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }

    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-4">

    <!-- Configuración mínima de Firebase/Auth para el entorno Canvas -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Variables globales del entorno Canvas (MANDATORIAS)
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        let db, auth;
        let userId;

        // Inicialización de Firebase
        if (Object.keys(firebaseConfig).length > 0) {
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            auth = getAuth(app);

            async function authenticate() {
                try {
                    if (initialAuthToken) {
                        const userCredential = await signInWithCustomToken(auth, initialAuthToken);
                        userId = userCredential.user.uid;
                    } else {
                        const userCredential = await signInAnonymously(auth);
                        userId = userCredential.user.uid;
                    }
                    console.log("Firebase Auth inicializado. User ID:", userId);
                    document.getElementById('user-id-display').textContent = `ID: ${userId}`;
                } catch (error) {
                    console.error("Error durante la autenticación de Firebase:", error);
                    userId = crypto.randomUUID(); // Fallback ID
                }
            }
            authenticate();
        } else {
            console.log("Firebase no configurado, usando ID de sesión local.");
            userId = crypto.randomUUID();
            document.getElementById('user-id-display').textContent = `ID: ${userId}`;
        }
    </script>

    <!-- Título y ID de Usuario -->
    <header class="mb-6 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white mb-2">ParGEnius 🤖</h1>
        <p id="user-id-display" class="text-xs text-gray-400"></p>
        <p id="turn-indicator" class="text-xl font-semibold mt-3 text-yellow-300">Turno: Amarillo (Tú)</p>
    </header>

    <!-- Contenedor principal del Tablero (100% de ancho, altura dinámica) -->
    <div id="board-container" class="board-container relative grid grid-cols-13 grid-rows-13 gap-0.5 shadow-2xl">
        <!-- El tablero se llenará con JavaScript para mayor control -->
    </div>

    <!-- Panel de Control y Dado -->
    <div class="mt-8 flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-8 w-full max-w-lg">
        <!-- Display del Dado -->
        <div class="dice-display text-white" id="dice-display">
            <span id="dice-value">?</span>
        </div>

        <!-- Botón de Tirar -->
        <button id="roll-button"
            class="dice-button px-8 py-4 text-white font-bold rounded-xl uppercase tracking-wider transition duration-300"
            onclick="rollDice()">
            Tirar Dado
        </button>
    </div>

    <!-- Panel de Jugadores (Información de Fichas en Meta) -->
    <div id="player-status" class="mt-6 flex justify-around w-full max-w-lg text-sm font-medium">
        <!-- Se rellena con JS -->
    </div>

    <!-- Overlay de Notificación Generativa (Oculto por defecto) -->
    <div id="notification-overlay" class="fixed inset-0 hidden items-center justify-center">
        <div class="notification-box p-8 bg-gray-800 rounded-2xl shadow-xl text-center max-w-md w-full border-4 border-white transform scale-100">
            <h2 id="notification-title" class="text-3xl font-extrabold mb-3 text-white">¡CAPTURA ÉPICA!</h2>
            <p id="notification-message" class="text-lg mb-4 text-gray-300">El jugador Amarillo ha forzado una aniquilación y ha enviado la ficha Roja al punto de partida.</p>
            <button onclick="hideNotification()" class="mt-3 px-6 py-2 bg-yellow-500 text-gray-900 font-bold rounded-lg hover:bg-yellow-400 transition">Entendido</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Inicializar juego al cargar la página
            initGame();
        });

        // --- CONSTANTES DEL JUEGO ---
        const PLAYERS = {
            YELLOW: { id: 'Y', name: 'Amarillo (Tú)', color: '#fcd34d', start: 0, home: 52, dice: true, path: [] },
            BLUE: { id: 'B', name: 'Azul', color: '#3b82f6', start: 13, home: 68, dice: false, path: [] },
            RED: { id: 'R', name: 'Rojo (IA)', color: '#ef4444', start: 26, home: 84, dice: false, path: [] },
            GREEN: { id: 'G', name: 'Verde', color: '#10b981', start: 39, home: 100, dice: false, path: [] }
        };
        const TOTAL_PATH_SQUARES = 68; // 52 camino exterior + 4 * 4 meta interior
        const SAFES = [5, 12, 17, 24, 29, 36, 41, 48]; // Posiciones seguras (contando desde 1)

        let gameState = {
            pieces: [], // [{ player: 'Y', id: 1, position: 'Y-H1' (Home) or 1 (Path) or 'Y-G1' (Goal) }]
            turn: 'YELLOW',
            diceValue: 0,
            hasRolled: false,
            waitingForMove: false,
            currentPlayer: 'YELLOW'
        };

        const THEMES = [
            { bg: '#1a1a2e', accent: '#e94560', dark: '#16213e', light: '#2c2e43', name: 'Neon Grid' },
            { bg: '#392F5A', accent: '#FFD700', dark: '#504176', light: '#8679A8', name: 'Synthwave Sunset' },
            { bg: '#003333', accent: '#00FFFF', dark: '#004C4C', light: '#008080', name: 'Aqua Glitch' },
        ];

        // Mapeo de Posiciones de Fichas en el DOM (posición en el camino a ID de casilla)
        const pathSquareMap = {};

        // --- INICIALIZACIÓN Y RENDERING ---

        function initGame() {
            // 1. Aplicar Tema Generativo
            applyGenerativeTheme();

            // 2. Generar Tablero Visual
            createBoardDOM();

            // 3. Generar Fichas y Estado
            createInitialGameState();

            // 4. Iniciar Interfaz
            updateUI();
        }

        function applyGenerativeTheme() {
            const themeIndex = Math.floor(Math.random() * THEMES.length);
            const theme = THEMES[themeIndex];

            document.documentElement.style.setProperty('--bg-color', theme.bg);
            document.documentElement.style.setProperty('--accent-color', theme.accent);
            document.documentElement.style.setProperty('--board-color-dark', theme.dark);
            document.documentElement.style.setProperty('--board-color-light', theme.light);

            console.log(`Tema Generativo Aplicado: ${theme.name}`);
        }

        function createBoardDOM() {
            const board = document.getElementById('board-container');
            board.innerHTML = ''; // Limpiar

            // Definición de las 13x13 celdas del tablero
            for (let r = 0; r < 13; r++) {
                for (let c = 0; c < 13; c++) {
                    const cell = document.createElement('div');
                    cell.className = 'path-square';

                    // Lógica para asignar IDs y clases al tablero
                    const pos = getParchisPosition(r, c);

                    if (pos.type === 'PATH' || pos.type === 'GOAL_ENTRY') {
                        cell.classList.add('path-square');
                        cell.id = `P-${pos.pathIndex}`;
                        pathSquareMap[pos.pathIndex] = cell.id;

                        // Casillas de salida y meta interior
                        if (pos.isStart) cell.classList.add(`start-${pos.player.toLowerCase()}`);
                        if (pos.isSafe) cell.classList.add('safe');
                        if (pos.isGoalEntry) cell.classList.add('goal-entry', `goal-${pos.player.toLowerCase()}`);
                    } else if (pos.type === 'HOUSE') {
                        cell.className = `flex flex-wrap items-center justify-center house-${pos.player.toLowerCase()} p-2`;
                        cell.innerHTML = `
                            <div id="${pos.player}-H1" class="piece-home w-1/2 h-1/2 flex items-center justify-center"></div>
                            <div id="${pos.player}-H2" class="piece-home w-1/2 h-1/2 flex items-center justify-center"></div>
                            <div id="${pos.player}-H3" class="piece-home w-1/2 h-1/2 flex items-center justify-center"></div>
                            <div id="${pos.player}-H4" class="piece-home w-1/2 h-1/2 flex items-center justify-center"></div>
                        `;
                    } else if (pos.type === 'GOAL_SQUARE') {
                        cell.className = `path-square goal-${pos.player.toLowerCase()} font-bold`;
                        cell.id = `${pos.player}-G${pos.goalIndex}`;
                    } else if (pos.type === 'GOAL_CENTER') {
                        cell.className = `flex items-center justify-center text-4xl font-extrabold text-white bg-gray-600 rounded-lg`;
                        cell.textContent = '🏠'; // Centro de la meta
                    } else {
                        // Celdas vacías (esquinas)
                        cell.classList.add('bg-transparent', 'border-none');
                    }

                    board.appendChild(cell);
                }
            }
        }

        // Función para mapear (row, col) a una posición lógica del Parchís (simplificado)
        // (Esta es una simplificación compleja de un tablero de 13x13 y sólo mapea las casas y el centro)
        function getParchisPosition(r, c) {
            // Casas
            if (r >= 0 && r <= 5 && c >= 0 && c <= 5) return { type: 'HOUSE', player: 'YELLOW' };
            if (r >= 0 && r <= 5 && c >= 7 && c <= 12) return { type: 'HOUSE', player: 'GREEN' };
            if (r >= 7 && r <= 12 && c >= 7 && c <= 12) return { type: 'HOUSE', player: 'RED' };
            if (r >= 7 && r <= 12 && c >= 0 && c <= 5) return { type: 'HOUSE', player: 'BLUE' };

            // Meta Central
            if (r >= 6 && r <= 6 && c >= 6 && c <= 6) return { type: 'GOAL_CENTER' };

            // La lógica real de PATH y GOAL_SQUARE es muy compleja y se omite por la simulación
            // Pero asignamos las posiciones iniciales conocidas para que las fichas tengan dónde empezar
            const pathIndex = calculatePathIndex(r, c);
            const isStart = (r === 8 && c === 1) || (r === 1 && c === 8) || (r === 4 && c === 11) || (r === 11 && c === 4);
            const isSafe = (SAFES.includes(pathIndex)); // Simplificación

            // Asignación de índices del camino (simulada)
            if (pathIndex !== -1) {
                return {
                    type: 'PATH',
                    pathIndex: pathIndex,
                    isSafe: isSafe,
                    isStart: isStart,
                    // Simplificación de a qué jugador pertenece
                    player: isStart ? Object.keys(PLAYERS).find(key => PLAYERS[key].start === pathIndex) : null,
                };
            }

            // Simplificación para casillas interiores de meta
            if ((r === 6 && c >= 1 && c <= 5) || (c === 6 && r <= 5 && r >= 1)) {
                 return { type: 'GOAL_SQUARE', player: 'YELLOW', goalIndex: 5 - c };
            }
            if ((r === 6 && c >= 7 && c <= 11) || (c === 6 && r <= 11 && r >= 7)) {
                return { type: 'GOAL_SQUARE', player: 'RED', goalIndex: c - 7 };
            }

            return { type: 'EMPTY' };
        }

        // Función de simulación para asignar un índice de camino único
        function calculatePathIndex(r, c) {
             const pathMap = {
                // Posiciones de Salida
                '8,1': 0, '1,8': 13, '4,11': 26, '11,4': 39,
                // Algunas casillas seguras
                '1,4': 5, '4,1': 6, '4,8': 17, '8,4': 41,
                // Meta de 4 casillas (simuladas)
                '6,5': 60, '6,7': 61, '5,6': 62, '7,6': 63
             };
             return pathMap[`${r},${c}`] || -1;
        }

        function createInitialGameState() {
            gameState.pieces = [];
            Object.values(PLAYERS).forEach(player => {
                for (let i = 1; i <= 4; i++) {
                    gameState.pieces.push({
                        player: player.id,
                        id: i,
                        position: `${player.id}-H${i}`, // E.g., 'Y-H1' (Home)
                        inGoal: false
                    });
                }
            });
            renderPieces();
        }

        // --- LÓGICA DEL JUEGO ---

        function rollDice() {
            if (gameState.hasRolled || gameState.waitingForMove) {
                showNotification("Espera tu turno", "Ya has tirado el dado o estás esperando para mover una ficha.", "warning");
                return;
            }

            const value = Math.floor(Math.random() * 6) + 1;
            gameState.diceValue = value;
            gameState.hasRolled = true;
            document.getElementById('dice-value').textContent = value;
            
            animateDice(value);

            // Simulación de Notificación Generativa al sacar un 6
            if (value === 6) {
                showNotification("¡Generación Crítica!", "Has desatado un 6, el sistema te otorga otra tirada.", "success");
            } else {
                // Pequeño delay para la animación
                setTimeout(() => checkPossibleMoves(), 500);
            }
        }
        
        function animateDice(value) {
            const diceDisplay = document.getElementById('dice-display');
            // Simula un giro 3D (UX/UI dinámico)
            diceDisplay.style.transform = `rotateY(${Math.random() * 720 + 360}deg) rotateX(${Math.random() * 720 + 360}deg) scale(1.1)`;
            setTimeout(() => {
                diceDisplay.style.transform = `rotateY(0deg) rotateX(0deg) scale(1)`;
            }, 300);
        }

        function checkPossibleMoves() {
            const currentPieces = gameState.pieces.filter(p => p.player === gameState.currentPlayer);
            let movablePieces = [];

            currentPieces.forEach(piece => {
                const isMovable = canMove(piece, gameState.diceValue);
                if (isMovable) {
                    movablePieces.push(piece);
                    highlightPiece(piece.position);
                }
            });

            if (movablePieces.length > 0) {
                gameState.waitingForMove = true;
                // Si es la IA, ejecuta la lógica de IA
                if (gameState.currentPlayer === 'RED') {
                    // Retraso para simular "pensamiento" de la IA
                    setTimeout(AILogic, 1000);
                } else {
                    document.getElementById('roll-button').disabled = true;
                }
            } else {
                // No hay movimientos, pasar el turno
                showNotification("Movimiento Denegado", "No hay fichas que puedan moverse con un " + gameState.diceValue + ".", "warning");
                setTimeout(endTurn, 1500);
            }
        }
        
        function canMove(piece, diceValue) {
            const playerConfig = PLAYERS[piece.player];
            const currentPos = piece.position;

            // 1. Está en Casa ('Y-H1')
            if (currentPos.includes('-H')) {
                return diceValue === 5;
            }

            // 2. Está en el Camino (número)
            if (typeof currentPos === 'number') {
                // Check for goal entry path
                if (currentPos + diceValue > playerConfig.home) {
                    return false; // Se pasaría de la entrada de meta, no puede mover
                }
                
                // Check for blockades (two pieces of same color) - simplified for 2 pieces max
                // Ignorado para simplificar la simulación del tablero, ya que el renderizado 13x13 no es real.
                
                return true;
            }
            
            // 3. Está en la Meta ('Y-G1')
            if (currentPos.includes('-G')) {
                const goalIndex = parseInt(currentPos.slice(-1));
                if (goalIndex + diceValue <= 4) {
                    return true;
                }
                return false; // Se pasaría de la meta final
            }
            
            return false;
        }

        // --- LÓGICA DE MOVIMIENTO ---

        function movePiece(pieceId, finalPos) {
             const piece = gameState.pieces.find(p => p.position === pieceId);
             if (!piece || !gameState.waitingForMove) return;

             const diceValue = gameState.diceValue;

             let newPos;
             let isCapture = false;

             // Lógica de Movimiento
             if (piece.position.includes('-H') && diceValue === 5) {
                 // Salir de Casa
                 newPos = PLAYERS[piece.player].start;
             } else if (typeof piece.position === 'number') {
                 // Mover en el Camino
                 let currentPathIndex = piece.position;
                 let newPathIndex = currentPathIndex + diceValue;

                 // Manejar la vuelta al inicio del path si es necesario
                 if (newPathIndex >= 52) {
                     newPathIndex -= 52;
                 }
                 newPos = newPathIndex;

                 // Comprobar Captura
                 const piecesAtTarget = gameState.pieces.filter(p => p.position === newPos);
                 if (piecesAtTarget.length > 0 && !SAFES.includes(newPos)) {
                     const capturedPiece = piecesAtTarget[0];
                     if (capturedPiece.player !== piece.player) {
                         isCapture = true;
                         // Enviar pieza capturada a casa
                         sendPieceHome(capturedPiece);
                     }
                 }

             } else if (piece.position.includes('-G')) {
                 // Mover en la Meta (Simplificado)
                 const goalIndex = parseInt(piece.position.slice(-1));
                 const newGoalIndex = goalIndex + diceValue;
                 if (newGoalIndex === 4) { // Asumimos 4 es la casilla final
                     piece.inGoal = true;
                     newPos = 'GOAL';
                     showNotification("¡Éxito de Infiltración!", `La ficha ${piece.id} de ${PLAYERS[piece.player].name} ha llegado a la meta.`, "goal");
                 } else {
                     newPos = `${piece.player}-G${newGoalIndex}`;
                 }
             }

             // Actualizar posición de la pieza
             piece.position = newPos;

             // Renderizar y terminar turno
             renderPieces();
             removeHighlights();

             if (isCapture) {
                 // Notificación generativa por captura
                 showNotification("¡Aniquilación Táctica!", `El ${PLAYERS[piece.player].name} ha **eliminado** un token enemigo con precisión letal.`, "capture");
                 // El jugador que captura repite turno
                 gameState.diceValue = 6;
             }

             // El turno termina a menos que haya sacado un 6 o capturado
             if (gameState.diceValue !== 6 && !isCapture) {
                 endTurn();
             } else {
                 // Si repite, reinicia el estado de tirada
                 gameState.hasRolled = false;
                 gameState.waitingForMove = false;
                 document.getElementById('roll-button').disabled = false;
                 updateUI();
                 // Si es la IA y repite, que tire de nuevo
                 if (gameState.currentPlayer === 'RED') {
                    setTimeout(rollDice, 1000);
                 }
             }
        }
        
        function sendPieceHome(piece) {
            const homePieces = gameState.pieces.filter(p => p.player === piece.player && p.position.includes('-H'));
            piece.position = `${piece.player}-H${homePieces.length + 1}`;
            renderPieces();
        }

        // --- LÓGICA DE LA IA ("The Predictor") ---

        function AILogic() {
            const aiPlayer = 'RED';
            const aiPieces = gameState.pieces.filter(p => p.player === aiPlayer);
            const dice = gameState.diceValue;
            
            // 1. Prioridad: Salir si saca 5 y hay fichas en casa
            let homePiece = aiPieces.find(p => p.position.includes('-H') && dice === 5);
            if (homePiece) {
                movePiece(homePiece.position, PLAYERS[aiPlayer].start);
                return;
            }
            
            // 2. Prioridad: Capturar si es posible
            // (Lógica compleja omitida por simplificación, solo movemos la más avanzada)
            
            // 3. Prioridad: Mover la ficha más avanzada
            let movablePieces = aiPieces.filter(p => canMove(p, dice));
            if (movablePieces.length > 0) {
                // Simulación: La IA elige la pieza con la posición más alta
                let bestPiece = movablePieces.reduce((prev, current) => {
                    const prevPos = typeof prev.position === 'number' ? prev.position : -1;
                    const currentPos = typeof current.position === 'number' ? current.position : -1;
                    return (prevPos > currentPos) ? prev : current;
                });
                
                // Simulación de "Predicción"
                const decisionText = bestPiece ? `(Predicción: Mover ficha ${bestPiece.id} para maximizar el avance.)` : '';
                showNotification("Análisis de Predictor", `La IA ha elegido su movimiento. ${decisionText}`, "ai-move");
                
                // Ejecutar movimiento
                // En un juego real, la IA calcularía la posición final y llamaría a movePiece.
                // Aquí, simplemente llamamos a movePiece con la posición actual para que el sistema la calcule.
                setTimeout(() => movePiece(bestPiece.position, null), 1000);

            } else {
                 // Esto no debería pasar si checkPossibleMoves fue llamada antes
                 endTurn();
            }
        }

        // --- RENDERIZADO DE FICHAS Y UX/UI ---

        function renderPieces() {
            // Limpiar todas las posiciones antes de renderizar
            document.querySelectorAll('.piece-container').forEach(el => el.remove());

            gameState.pieces.forEach(piece => {
                const playerConfig = PLAYERS[piece.player];
                let targetId;

                if (piece.position.includes('-H') || piece.position.includes('-G')) {
                    targetId = piece.position; // Home o Goal individual
                } else if (typeof piece.position === 'number') {
                    targetId = pathSquareMap[piece.position]; // Posición en el camino
                } else {
                     // Ficha en meta final (ocultar)
                     return;
                }

                const targetCell = document.getElementById(targetId);
                if (targetCell) {
                    // Crear contenedor para la ficha
                    const pieceContainer = document.createElement('div');
                    pieceContainer.id = `PCE-${piece.player}${piece.id}`;
                    pieceContainer.className = 'piece-container absolute top-0 left-0 w-full h-full flex justify-center items-center';
                    pieceContainer.style.transition = 'transform 0.4s ease-in-out'; // Animación de movimiento

                    // Crear la ficha visual
                    const pieceElement = document.createElement('div');
                    pieceElement.className = 'piece';
                    pieceElement.style.backgroundColor = playerConfig.color;
                    pieceElement.textContent = piece.id;
                    pieceElement.style.color = 'black';
                    pieceElement.style.fontSize = '0.75rem';

                    // Manejador de clic para mover
                    if (piece.player === gameState.currentPlayer && gameState.waitingForMove && piece.player !== 'R') {
                        pieceElement.onclick = () => movePiece(piece.position, null);
                        pieceElement.classList.add('cursor-pointer');
                    } else {
                        pieceElement.onclick = null;
                        pieceElement.classList.remove('cursor-pointer');
                    }

                    pieceContainer.appendChild(pieceElement);
                    targetCell.appendChild(pieceContainer);
                }
            });

            updatePlayerStatus();
        }

        function highlightPiece(position) {
            let targetId;
             if (position.includes('-H') || position.includes('-G')) {
                targetId = position;
             } else if (typeof position === 'number') {
                targetId = pathSquareMap[position];
             }

            const pieceElement = document.getElementById(`PCE-${gameState.currentPlayer}${gameState.pieces.find(p => p.position === position).id}`);
            if (pieceElement) {
                pieceElement.querySelector('.piece').classList.add('highlight-movable');
            }
        }

        function removeHighlights() {
            document.querySelectorAll('.highlight-movable').forEach(el => {
                el.classList.remove('highlight-movable');
            });
            gameState.waitingForMove = false;
        }

        function endTurn() {
            removeHighlights();

            // Determinar el siguiente jugador
            const players = Object.keys(PLAYERS);
            const currentIndex = players.indexOf(gameState.currentPlayer);
            const nextIndex = (currentIndex + 1) % players.length;
            gameState.currentPlayer = players[nextIndex];
            gameState.hasRolled = false;
            gameState.diceValue = 0;
            document.getElementById('roll-button').disabled = false;
            document.getElementById('dice-value').textContent = '?';

            updateUI();

            // Si el siguiente jugador es la IA, iniciar su turno
            if (gameState.currentPlayer === 'RED') {
                setTimeout(rollDice, 1500);
            }
        }

        function updateUI() {
            const playerConfig = PLAYERS[gameState.currentPlayer];
            const turnIndicator = document.getElementById('turn-indicator');
            turnIndicator.textContent = `Turno: ${playerConfig.name}`;
            turnIndicator.style.color = playerConfig.color;

            const rollButton = document.getElementById('roll-button');
            if (gameState.currentPlayer === 'RED') {
                 rollButton.disabled = true;
                 rollButton.textContent = 'IA Pensando...';
            } else {
                rollButton.disabled = gameState.hasRolled;
                rollButton.textContent = gameState.hasRolled ? 'Mover Ficha' : 'Tirar Dado';
            }
        }

        function updatePlayerStatus() {
             const statusPanel = document.getElementById('player-status');
             statusPanel.innerHTML = '';
             Object.values(PLAYERS).forEach(p => {
                 const piecesInGoal = gameState.pieces.filter(piece => piece.player === p.id && piece.inGoal).length;
                 const statusEl = document.createElement('div');
                 statusEl.className = 'flex flex-col items-center p-2 rounded-lg';
                 statusEl.innerHTML = `
                     <div class="w-4 h-4 rounded-full mb-1" style="background-color: ${p.color};"></div>
                     <span class="text-xs text-gray-300">${p.name}</span>
                     <span class="text-lg font-bold">${piecesInGoal}/4</span>
                 `;
                 statusPanel.appendChild(statusEl);
             });
        }

        // --- NOTIFICACIÓN MODAL GENERATIVA ---

        function showNotification(title, message, type) {
            const overlay = document.getElementById('notification-overlay');
            const titleEl = document.getElementById('notification-title');
            const messageEl = document.getElementById('notification-message');
            const box = document.querySelector('.notification-box');

            titleEl.textContent = title;
            messageEl.textContent = message;

            // Estilos generativos basados en el tipo de evento
            box.classList.remove('border-white', 'border-red-500', 'border-yellow-500', 'border-green-500');
            titleEl.classList.remove('text-red-500', 'text-yellow-500', 'text-green-500');

            switch (type) {
                case 'success':
                    box.classList.add('border-green-500');
                    titleEl.classList.add('text-green-500');
                    break;
                case 'capture':
                    box.classList.add('border-red-500');
                    titleEl.classList.add('text-red-500');
                    break;
                case 'warning':
                    box.classList.add('border-yellow-500');
                    titleEl.classList.add('text-yellow-500');
                    break;
                case 'goal':
                    box.classList.add('border-blue-500');
                    titleEl.classList.add('text-blue-500');
                    break;
                default:
                    box.classList.add('border-white');
            }

            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
        }

        function hideNotification() {
            document.getElementById('notification-overlay').classList.remove('flex');
            document.getElementById('notification-overlay').classList.add('hidden');
        }

    </script>
</body>
</html>
